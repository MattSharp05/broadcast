# Copy to .env.local for local development. Never commit real values.
# Production values live in Vercel env vars and GitHub Actions secrets (docs/TDD.md → Environments & deploy).

# Supabase project URL (local: printed by `supabase start`, usually http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key; safe in the browser, access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key; server only, used solely in src/lib/db/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase personal access token for applying migrations from CI (CI only).
SUPABASE_ACCESS_TOKEN=
# Supabase project ref of the production project, used with SUPABASE_ACCESS_TOKEN (CI only).
SUPABASE_PROJECT_REF=
# Database password of the production project, for `supabase db push` (CI only).
SUPABASE_DB_PASSWORD=

# The one email address allowed to sign in with a magic link.
ALLOWED_EMAIL=
# 1 turns on the e2e sign-in helper (/auth/test-sign-in). Never set it in production.
E2E=
# Key that encrypts OAuth tokens at rest: 32 random bytes, base64 (`openssl rand -base64 32`).
TOKEN_ENC_KEY=
# Shared secret that pg_cron sends to POST /api/cron/tick.
CRON_SECRET=

# Instagram app (Instagram Login). Leave empty locally to use the fake provider.
IG_APP_ID=
IG_APP_SECRET=

# Public base URL of the app, used for OAuth redirects (local: http://localhost:3000).
APP_URL=http://localhost:3000
